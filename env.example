# Copy this file to .env and fill in real values. Never commit .env itself.

OPENAI_API_KEY=sk-...
STRIPE_SECRET_KEY=sk_test_...
# Only needed if you set up a Stripe webhook (recommended before going live,
# see README.md). Leave unset for local development.
STRIPE_WEBHOOK_SECRET=whsec_...

# On Render, leave PUBLIC_URL unset - the app uses Render's own
# RENDER_EXTERNAL_URL automatically. Set it explicitly on other hosts.
PUBLIC_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# Optional overrides - both have sensible defaults if omitted.
PRICE_CENTS=1200
CURRENCY=usd
